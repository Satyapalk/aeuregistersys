<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <handlers>
      <add
        name="httpPlatformHandler"
        path="*"
        verb="*"
        modules="httpPlatformHandler"
        resourceType="Unspecified"
      />
    </handlers>

    <httpPlatform
      processPath="node"
      arguments="app.js"
      startupTimeLimit="120"
      startupRetryCount="3"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\node.log">

      <environmentVariables>
        <environmentVariable
          name="PORT"
          value="%HTTP_PLATFORM_PORT%"
        />

        <environmentVariable
          name="NODE_ENV"
          value="production"
        />
      </environmentVariables>

    </httpPlatform>

  </system.webServer>
</configuration>